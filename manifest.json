{
  "manifest_version": 3,
  "name": "ChatGPT Auto-Collapse Sidebar",
  "version": "0.0.1",
  "description": "Auto-collapses the ChatGPT sidebar on page load.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["index.js"],
      "run_at": "document_idle"
    }
  ]
}